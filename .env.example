# ==========================================
# Anthropic API Configuration
# ==========================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==========================================
# Model Architecture
# ==========================================
# Fast classifier for 4-field taxonomy mapping
CLASSIFIER_MODEL=claude-3-5-haiku-20241022

# High-reasoning model for grounded draft responses & critique passes
DRAFT_MODEL=claude-3-5-sonnet-20241022

# Temperature setting for deterministic outputs
TEMPERATURE=0.0

# ==========================================
# Pipeline Limits & Thresholds
# ==========================================
# Confidence score below which tickets are sent to human review
CONF_THRESHOLD=0.80

# Minimum reciprocal rank fusion score required for top KB chunk
RRF_MIN=0.015

# Maximum redraft attempts allowed following a critic rejection
MAX_CORRECTIONS=2

# Number of concurrent workers for batch processing
WORKERS=5

# ==========================================
# Retrieval & Knowledge Base
# ==========================================
# Dense vector store backend: "tfidf" (lightweight) or "minilm" (sentence-transformers)
DENSE_BACKEND=tfidf

# Path to the knowledge base directory
KB_DIR=kb